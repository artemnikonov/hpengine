<Project Sdk="Microsoft.NET.Sdk">
  <!-- HPEngine Launcher for Windows and Linux (Avalonia): the player-facing behaviour of launcher/Launcher.swift (macOS).
       Published self-contained, single file (make_launcher.sh), NOT trimmed: Avalonia trimming could not be verified on
       the target systems. Window icon: ShieldIcon.cs (drawn in code). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HPEngineLauncher</AssemblyName>
    <RootNamespace>HPEngine.Launcher</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../VERSION').Trim())</Version>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <!-- The game titles' serif: Cormorant Garamond Bold (SIL OFL 1.1, Fonts/README.md), with its licence. -->
    <AvaloniaResource Include="Fonts/CormorantGaramond-Bold.otf;Fonts/CormorantGaramond-LICENSE.txt" />
    <!-- The engine's own rule for "this folder is a game" (Logic.cs DataDir.OwnGame): one recogniser, not two. -->
    <Compile Include="../../hpengine/packaging/InstallRoot.cs" Link="InstallRoot.cs" />
    <!-- The engine's own mod placement rule (Logic.cs StartMap: the maps the enabled mods add). -->
    <Compile Include="../../hpengine/packaging/ModOverlay.cs" Link="ModOverlay.cs" />
    <Compile Include="../../hpengine/packaging/ModInstall.cs" Link="ModInstall.cs" />
    <Compile Include="../../hpengine/packaging/GameLanguage.cs" Link="GameLanguage.cs" />
    <PackageReference Include="Avalonia" Version="11.3.23" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.23" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.23" />
    <!-- Ed25519 verification of the self-update (.NET has none built in) -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.4.0" />
  </ItemGroup>
  <!-- The release public key (Ed25519, base64) the self-update verifies against; make_launcher.sh passes -p:HPEngineUpdateKey=... -->
  <ItemGroup Condition="'$(HPEngineUpdateKey)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>HPEngineUpdateKey</_Parameter1>
      <_Parameter2>$(HPEngineUpdateKey)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <!-- HP2 in the launcher (Logic.cs Hp2Release): make_launcher.sh passes -p:HPEngineHp2=true unless HPENGINE_HP2=0 (from 0.5.0) -->
  <ItemGroup Condition="'$(HPEngineHp2)' == 'true'">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>HPEngineHp2</_Parameter1>
      <_Parameter2>true</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
