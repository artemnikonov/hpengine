    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Desktop/HPEngineLauncher.csproj" />
    <PackageReference Include="Avalonia.Headless" Version="11.3.23" />
  </ItemGroup>
</Project>
