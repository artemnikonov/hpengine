# Describes the style the code already has; it is not a target to reformat towards.
# Measured on HP1.Core, hpengine, runtime_poc (*.cs): 4-space indent, no tabs, LF, UTF-8 without BOM, final newline,
# Allman braces; line length p50 62, p95 124, p99 159 (a guideline, not enforced).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,csproj,props,proj}]
indent_size = 2

[*.cs]
max_line_length = 160
trim_trailing_whitespace = true

# Braces on their own line (Allman), as in almost all of the code.
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
# Compact one-line members and statements are common; keep them.
csharp_preserve_single_line_blocks = true
csharp_preserve_single_line_statements = true

# Preferences only (suggestions, never build errors). The code mixes `var` and explicit types.
csharp_style_var_for_built_in_types = false:silent
csharp_style_var_when_type_is_apparent = true:silent
csharp_style_var_elsewhere = false:silent
csharp_prefer_braces = when_multiline:silent
dotnet_sort_system_directives_first = true
