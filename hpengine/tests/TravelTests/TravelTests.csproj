<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests of the Travel subsystem: synthetic WorldFrame/HudCommand -> expectations written out
       by hand from the rules of the HP1TravelFrameHold.cs reference (not from the port's output).
       dotnet run -> 0 / ≠0 with a reason. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HPEngine.Travel.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Travel/*.cs" Link="Travel/%(Filename)%(Extension)" />
    <Compile Include="../../Hud/HudBatcher.cs;../../Hud/HudQuad.cs" Link="Hud/%(Filename)%(Extension)" />
    <ProjectReference Include="../../../HP1.Core/HP1.Core.csproj" />
  </ItemGroup>
</Project>
