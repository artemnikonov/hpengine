#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_FU
{
    float4 mode;
};

struct fs_main_out
{
    float4 out_var_SV_Target0 [[color(0)]];
};

struct fs_main_in
{
    float2 in_var_TEXCOORD0 [[user(locn0)]];
    float4 in_var_TEXCOORD1 [[user(locn1)]];
};

fragment fs_main_out fs_main(fs_main_in in [[stage_in]], constant type_FU& FU [[buffer(0)]], texture2d<float> tex [[texture(0)]], sampler texSmplr [[sampler(0)]])
{
    fs_main_out out = {};
    float4 _106;
    do
    {
        float4 _48 = tex.sample(texSmplr, in.in_var_TEXCOORD0);
        if (FU.mode.x > 2.5)
        {
            _106 = float4(rint(powr(fast::clamp(_48.xyz, float3(0.0), float3(1.0)), float3(FU.mode.z)) * 65535.0) * float3(1.525902189314365386962890625e-05), 1.0);
            break;
        }
        if (FU.mode.x > 1.5)
        {
            if (FU.mode.y > 0.5)
            {
                if ((_48.w - 0.5) < 0.0)
                {
                    discard_fragment();
                }
            }
            _106 = float4(_48.xyz, 1.0);
            break;
        }
        if (FU.mode.x > 0.5)
        {
            _106 = float4(_48.xyz * in.in_var_TEXCOORD1.xyz, 1.0);
            break;
        }
        _106 = float4(fast::clamp(_48.xyz * in.in_var_TEXCOORD1.xyz, float3(0.0), float3(1.0)), _48.w * in.in_var_TEXCOORD1.w);
        break;
    } while(false);
    out.out_var_SV_Target0 = _106;
    return out;
}

