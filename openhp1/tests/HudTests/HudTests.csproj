<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests of the Hud subsystem: synthetic HudCommand/ViewFlashState -> expectations computed
       by hand from the Unity reference rules (not from the port's output). dotnet run -> 0 / ≠0 with a reason. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OpenHP1.Hud.Tests</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Hud/*.cs" Link="Hud/%(Filename)%(Extension)" />
    <!-- Only for the gpu mode (GpuTest.cs): the same version as the engine's. -->
    <PackageReference Include="ppy.SDL3-CS" Version="2026.1002.1" />
    <ProjectReference Include="../../../HP1.Core/HP1.Core.csproj" />
  </ItemGroup>
</Project>
