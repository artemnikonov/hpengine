#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_VU
{
    float4 r0;
    float4 r1;
    float4 r2;
    float4 r3;
};

struct vs_main_out
{
    float2 out_var_TEXCOORD0 [[user(locn0)]];
    float2 out_var_TEXCOORD1 [[user(locn1)]];
    float3 out_var_TEXCOORD2 [[user(locn2)]];
    float2 out_var_TEXCOORD3 [[user(locn3)]];
    float3 out_var_TEXCOORD4 [[user(locn4)]];
    float3 out_var_TEXCOORD5 [[user(locn5)]];
    float out_var_TEXCOORD6 [[user(locn6)]];
    float4 gl_Position [[position]];
};

struct vs_main_in
{
    float3 in_var_TEXCOORD0 [[attribute(0)]];
    float2 in_var_TEXCOORD1 [[attribute(1)]];
    float2 in_var_TEXCOORD2 [[attribute(2)]];
    float3 in_var_TEXCOORD3 [[attribute(3)]];
    float2 in_var_TEXCOORD4 [[attribute(4)]];
    float3 in_var_TEXCOORD5 [[attribute(5)]];
    float in_var_TEXCOORD6 [[attribute(6)]];
};

vertex vs_main_out vs_main(vs_main_in in [[stage_in]], constant type_VU& VU [[buffer(0)]])
{
    vs_main_out out = {};
    float4 _51 = float4(in.in_var_TEXCOORD0, 1.0);
    out.gl_Position = float4(dot(VU.r0, _51), dot(VU.r1, _51), dot(VU.r2, _51), dot(VU.r3, _51));
    out.out_var_TEXCOORD0 = in.in_var_TEXCOORD1;
    out.out_var_TEXCOORD1 = in.in_var_TEXCOORD2;
    out.out_var_TEXCOORD2 = in.in_var_TEXCOORD3;
    out.out_var_TEXCOORD3 = in.in_var_TEXCOORD4;
    out.out_var_TEXCOORD4 = in.in_var_TEXCOORD0;
    out.out_var_TEXCOORD5 = in.in_var_TEXCOORD5;
    out.out_var_TEXCOORD6 = in.in_var_TEXCOORD6;
    return out;
}

